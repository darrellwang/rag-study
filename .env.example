# 复制为 .env 后按需修改
# 普通（非容器）运行：
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 注意：用 docker-compose 启动时，容器内 localhost 指向容器自身，
# 需改为宿主地址以访问 Windows 上的 LMStudio：
#   LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.6-35b-a3b
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
CHROMA_PERSIST_DIR=./chroma_db
DOCS_DIR=./data

# ===== 切分与检索参数（阶段5）=====
# 切分粒度（字符）。中文常见区间 300~800：太小丢上下文，太大混主题
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 最终交给大模型的片段数
TOP_K=4
# 召回候选数，需大于 TOP_K，给融合和重排留筛选空间
FETCH_K=20
# 召回模式：vector | mmr | bm25 | hybrid（推荐 hybrid）
RETRIEVAL_MODE=hybrid
# 加权融合时向量通道的权重（RRF 模式下不生效）
VECTOR_WEIGHT=0.6
# RRF 平滑常数
RRF_K=60
# 是否默认启用 LLM 重排。即使已关闭思维链，重排仍需 fetch_k 次推理，
# 建议按需在单次请求里开，而不是全局默认打开
USE_RERANK=false

# 提示：重排/相关性评估/LLM 评判走 config.get_scoring_llm()，
# 它用 reasoning_effort=none 关闭思维链。实测同一次打分
# 开思考 48s（2539 个 reasoning token）vs 关思考 4.9s，结果一致。
# 若你的推理服务不支持该参数，代码会自动降级（只是慢，不会出错）。

# 服务端 API Key 鉴权（可选，留空则不校验）
# 设置后，所有 /kb /ingest /query 请求需在 Header 带 X-API-Key
KB_API_KEY=

# ===== 外部连接器凭据（全部留空时进入 MOCK 模式，仅用于跑通链路）=====
# Confluence
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_api_token
CONFLUENCE_SPACES=DEV,OPS

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token
JIRA_JQL=project IN (LOG,PAY) ORDER BY updated DESC

# GitHub（PAT，需 repo 读权限）
GITHUB_TOKEN=ghp_xxx
GITHUB_REPOS=octocat/Hello-World,owner/another-repo
GITHUB_BRANCH=main

